\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kansoy}[2026/10/24 Kansoy article style for sicilahval]
% Article adaptation of Fatih Kansoy's kansoy-article.sty (2026/10/10).
% The original is preserved. This portable edition omits project-specific
% bibliography settings and uses a compact layout for the software note.
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \input{glyphtounicode}
  \pdfgentounicode=1
\fi
\RequirePackage{sourceserifpro}
\RequirePackage[scaled=.9]{sourcecodepro}
\RequirePackage[a4paper,top=23mm,bottom=23mm,left=25mm,right=25mm]{geometry}
\RequirePackage{microtype,setspace,booktabs,array,needspace}
\RequirePackage{titlesec,enumitem,xcolor,xurl,fancyvrb}
\RequirePackage[colorlinks=true,allcolors=black,breaklinks=true]{hyperref}
\RequirePackage{bookmark}
\urlstyle{same}
\setstretch{1.08}
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\setlength{\emergencystretch}{2em}
\setlength{\tabcolsep}{5pt}
\renewcommand{\arraystretch}{1.15}
\titleformat{\section}{\large\bfseries}{}{0pt}{}
\titlespacing*{\section}{0pt}{12pt}{5pt}
\setlist{nosep,leftmargin=1.4em,topsep=3pt}
\DefineVerbatimEnvironment{Code}{Verbatim}{fontsize=\small,baselinestretch=1.05,frame=single,framesep=5pt}
\newcommand{\noteTitle}[4]{%
  {\LARGE\bfseries sicilahval\par}
  \vspace{3pt}{\large #1\par}
  \vspace{8pt}{Fatih Kansoy\hfill #2\par}
  {\small\href{mailto:kansoy@gmail.com}{kansoy@gmail.com}\quad\href{https://fatih.ai}{fatih.ai}\par}
  {\small #3\hfill #4\par}
  \vspace{8pt}\hrule\vspace{8pt}}
\newcommand{\sourcequote}[1]{\begin{quote}\small #1\end{quote}}
\newcommand{\smallref}[1]{\par\begingroup\small\raggedright #1\par\endgroup}
\AtBeginDocument{\frenchspacing}
\widowpenalty=10000
\clubpenalty=10000
\endinput
